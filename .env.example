NEXT_PUBLIC_SANITY_PROJECT_ID=placeholder_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-08

# Footer "Agent Portal" link target. Falls back to /studio (embedded Sanity
# Studio) when unset; replace with the real gated agent-portal URL before launch.
NEXT_PUBLIC_AGENT_PORTAL_URL=

# Vacation Request Form notifications (app/api/vacation-request/route.ts) — sent
# via Resend. Without RESEND_API_KEY the route still validates + logs each
# submission, it just doesn't send.
#   EMAIL_FROM must be on a domain verified in Resend (SPF/DKIM DNS added
#     alongside the existing Google Workspace MX for parksportsandparadise.com).
#   EMAIL_TO is the Google Workspace inbox Paige/Ashley monitor.
RESEND_API_KEY=
EMAIL_FROM="Parks Ports & Paradise <no-reply@parksportsandparadise.com>"
EMAIL_TO=hello@parksportsandparadise.com
