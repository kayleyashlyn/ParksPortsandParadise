NEXT_PUBLIC_SANITY_PROJECT_ID=placeholder_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-08

# Footer "Agent Portal" link target. Falls back to /studio (embedded Sanity
# Studio) when unset; replace with the real gated agent-portal URL before launch.
NEXT_PUBLIC_AGENT_PORTAL_URL=

# Vacation Request Form notifications (app/api/vacation-request/route.ts).
# Provider (Resend / SendGrid) is still an open decision — see TODO.md. Until
# EMAIL_PROVIDER_API_KEY is set, the API route validates + logs each submission
# but does NOT send an email.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=noreply@parksportsandparadise.com
EMAIL_TO=hello@parksportsandparadise.com
