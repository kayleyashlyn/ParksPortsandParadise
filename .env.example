NEXT_PUBLIC_SANITY_PROJECT_ID=placeholder_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-08

# Footer "Agent Portal" link target. Falls back to /studio (embedded Sanity
# Studio) when unset; replace with the real gated agent-portal URL before launch.
NEXT_PUBLIC_AGENT_PORTAL_URL=

# GA4 Measurement ID (property "Parks Ports and Paradise", stream 15748056048).
# The gtag loads via @next/third-parties only when this is set. Set it in Vercel
# *Production* so preview/dev traffic stays out of the data; leave it unset
# locally unless you're testing against GA4 DebugView.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
