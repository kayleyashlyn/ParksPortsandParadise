NEXT_PUBLIC_SANITY_PROJECT_ID=placeholder_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-08

# Canonical site origin (no trailing slash). Drives metadataBase, canonical
# URLs, sitemap.xml, and robots.txt. Vercel sets this per environment — use the
# preview deployment URL on preview, the production domain on production. Falls
# back to https://parksportsandparadise.com when unset.
NEXT_PUBLIC_SITE_URL=https://parksportsandparadise.com

# Footer "Agent Portal" link target — the advisors' external portal, a
# different system from this site. Falls back to the real client-confirmed
# URL (https://www.parksportsandparadise.com/agent-portal) when unset; only
# set this if the portal ever moves.
NEXT_PUBLIC_AGENT_PORTAL_URL=

# GA4 Measurement ID (property "Parks Ports and Paradise", stream 15748056048).
# The gtag loads via @next/third-parties only when this is set. Set it in Vercel
# *Production* so preview/dev traffic stays out of the data; leave it unset
# locally unless you're testing against GA4 DebugView.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Vacation Request Form notifications (app/api/vacation-request/route.ts) — sent
# via Resend. Without RESEND_API_KEY the route still validates + logs each
# submission, it just doesn't send.
#   EMAIL_FROM must be on a domain verified in Resend (SPF/DKIM DNS added
#     alongside the existing Google Workspace MX for parksportsandparadise.com).
#   EMAIL_TO is the Google Workspace inbox Paige/Ashley monitor.
RESEND_API_KEY=
EMAIL_FROM="Parks Ports & Paradise <no-reply@parksportsandparadise.com>"
EMAIL_TO=hello@parksportsandparadise.com
